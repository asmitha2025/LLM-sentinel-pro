# LLM Sentinel Pro production-style environment.
# Copy to .env, replace the API key, then run: .\scripts\start.ps1 -Production

SENTINEL_ENV=production
SENTINEL_API_KEY=replace-with-a-strong-release-key
SENTINEL_STATE_BACKEND=sqlite
SENTINEL_DB_PATH=
SENTINEL_EVALUATOR_ENGINE=local
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
